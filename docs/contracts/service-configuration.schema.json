        },
        "memoryMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "diskMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "deprecated": true
        },
        "ephemeralDiskMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "diskMode": {
          "enum": [
            "REQUEST_ONLY",
            "REQUIRED"
          ],
          "default": "REQUEST_ONLY"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServicePort"
          },
          "maxItems": 32
        },
        "environment": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecretRef"
          },
          "maxItems": 32
        },
        "volumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VolumeMount"
          },
          "maxItems": 16
        },
        "restartPolicy": {
          "$ref": "#/$defs/RestartPolicy"
        },
        "healthCheck": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "maxItems": 64,
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "args": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096,
                "pattern": "^[^\\u0000]*$"
              },
              "maxItems": 64,
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "containerId": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "const": "START"
        },
        "resolvedVolumes": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/ResolvedVolume" } },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "enum": [
              "ENVIRONMENT",
              "COMMAND_ARGS",
              "RESTART_POLICY",
              "SECRET_ENV",
              "SECRET_FILE",
              "NAMED_VOLUMES",
              "HEALTH_EXEC",
              "HEALTH_HTTP"
            ]
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "dockerContainerId": {
          "type": "null"
        }
      }
    },
    "ContainerResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageName",
        "cpuCores",
        "memoryMb",
        "diskMb",
        "ephemeralDiskMb",
        "diskMode",
        "ports",
        "environment",
        "secretRefs",
        "volumes",
        "restartPolicy",
        "healthCheck",
        "command",
        "args",
        "id",
        "status",
        "nodeId",
        "dockerContainerId",
        "errorMessage",
        "createdAt",
        "endpoints",
        "health"
      ],
      "properties": {
