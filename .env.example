# CloudBox Master - desenvolvimento local
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cloudbox
SPRING_DATASOURCE_USERNAME=cloudbox
SPRING_DATASOURCE_PASSWORD=cloudbox

# Gere um valor real com: openssl rand -base64 48
JWT_SECRET=substitua-por-um-segredo-base64-forte
JWT_EXPIRATION_SECONDS=3600
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=substitua-por-uma-senha-forte

HEARTBEAT_TIMEOUT_SECONDS=30
HEARTBEAT_CHECK_INTERVAL_SECONDS=10
SCHEDULER_MAX_TEMPERATURE_CELSIUS=75
